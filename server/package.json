{
  "name": "colorbook-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:engine": "tsx test-engine.ts",
    "test:pdf": "tsx test-pdf.ts",
    "test:phase3": "tsx test-my-books.ts",
    "test:cleanup": "tsx test-cleanup.ts",
    "test:all": "tsx test-engine.ts && tsx test-pdf.ts && tsx test-my-books.ts && tsx test-e2e-pdf.ts && tsx test-cleanup.ts",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.26.0",
    "@prisma/client": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
