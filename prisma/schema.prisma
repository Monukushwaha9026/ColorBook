// Prisma schema for ColorBook AI
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeGroup {
  kids
  children
  teens
  teen_plus
}

enum BookStatus {
  draft
  planning
  generating
  completed
  failed
  cancelled
}

enum PageStatus {
  pending
  generating
  completed
  failed
}

model Book {
  id                 String      @id @default(uuid())
  prompt             String
  ageGroup           AgeGroup    @default(children)
  pageCount          Int         @default(8)
  referenceImageUrl  String?     // Stored as relative path or asset reference, never raw binary
  status             BookStatus  @default(planning)
  paperSize          String      @default("A4")
  orientation        String      @default("PORTRAIT")
  pages              BookPage[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@map("books")
}

model BookPage {
  id          String      @id @default(uuid())
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber  Int
  concept     String
  imageUrl    String
  status      PageStatus  @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([bookId, pageNumber])
  @@index([bookId])
  @@map("book_pages")
}
